{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/i-use-orb-btw.txt",
    "padding": {
      "top":1
    },
    "color": {
      "1": "light_black"
    }
  },
  "display": {
    "color": {
      "keys": "blue",
      "title": "yellow"
    }
  },
  "modules": [
    "break",
    "title",
    "separator",
    {
      "type": "os",
      "format": "{name}"
    },
    {
      "type": "wm",
      "key": "WM",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "format": "{pretty-name}"
    },
    {
      "type": "editor",
      "format": "{name}"
    },
    "break",
    {
      "type": "cpu",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "format": "{name}"
    },
    {
      "type": "memory",
      "format": "{total} ({percentage})"
    },
    {
      "type": "display",
      "key": "Display",
      "format": "{width}x{height} @ {refresh-rate} ({scale-factor:3}x)"
    },
    "break",
    {
      "type": "Theme",
      "format": "Desert Witch"
    },
    {
      "type": "terminalfont",
      "key": "Font",
      "format": "{name}"
    },
    {
      "type": "cursor",
      "format": "{theme}"
    },
    "break",
    "colors"
  ]
}
