#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

(
    default_album_art_path: None,
    show_song_table_header: true,
    draw_borders: true,
    format_tag_separator: " | ",
    browser_column_widths: [
        20,
        38,
        42,
    ],
    background_color: "#3b3228",
    text_color: "#afd2e9",
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: false,
    preview_label_style: (
        fg: "yellow",
    ),
    preview_metadata_group_style: (
        fg: "yellow",
        modifiers: "Bold",
    ),
    tab_bar: (
        active_style: (
            fg: "#e68d53",
            bg: "#3b3228",
            modifiers: "Bold",
        ),
        inactive_style: (),
    ),
    highlighted_item_style: (
        fg: "#e68d53",
        modifiers: "Underlined",
    ),
    current_item_style: (
        fg: "black",
        bg: "#f8e2a0",
        modifiers: "Bold",
    ),
    borders_style: (
        fg: "blue",
    ),
    highlight_border_style: (
        fg: "blue",
    ),
    symbols: (
        song: "",
        dir: "󱍙",
        playlist: "󰲸",
        marker: "M",
        ellipsis: "...",
        song_style: None,
        dir_style: (
            fg: "#e68d53",
        ),
        playlist_style: None,
    ),
    level_styles: (
        info: (
            fg: "blue",
            bg: "black",
        ),
        warn: (
            fg: "#e68d53",
            bg: "black",
        ),
        error: (
            fg: "#e86045",
            bg: "black",
        ),
        debug: (
            fg: "light_green",
            bg: "black",
        ),
        trace: (
            fg: "magenta",
            bg: "black",
        ),
    ),
    album_art: (
        horizontal_align: "Right",
    ),
    progress_bar: (
        symbols: [
            "🭋",
            "█",
            "🭎",
            " ",
            " ",
        ],
        track_style: (
            fg: "#3b3228",
        ),
        elapsed_style: (
            fg: "#c1a387",
        ),
        thumb_style: (
            bg: "#3b3228",
            fg: "#c1a387",
        ),
        use_track_when_empty: false,
    ),
    scrollbar: (
        symbols: [
            "█",
            "█",
            "🭐",
            "🭧",
        ],
        track_style: (
            fg: "#4c4134",
        ),
        ends_style: (
            fg: "#c1a387",
        ),
        thumb_style: (
            fg: "blue",
        ),
    ),
    song_table_format: [
        (
            prop: (
                kind: Property(Artist),
                default: (
                    kind: Text("Unknown"),
                ),
            ),
            width: "20%",
        ),
        (
            prop: (
                kind: Property(Title),
                default: (
                    kind: Text("Unknown"),
                ),
            ),
            width: "35%",
        ),
        (
            prop: (
                kind: Property(Album),
                style: (
                    fg: "white",
                ),
                default: (
                    kind: Text("Unknown Album"),
                    style: (
                        fg: "white",
                    ),
                ),
            ),
            width: "30%",
        ),
        (
            prop: (
                kind: Property(Duration),
                default: (
                    kind: Text("-"),
                ),
            ),
            width: "15%",
            alignment: Right,
        ),
    ],
    components: {
        "head": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty()),
                ),
                (
                    size: "60%",
                    pane: Pane(Volume(
                            kind: Slider(
                                symbols: (
                                    start: "🭕",
                                    filled: "█",
                                    thumb: "🮔",
                                    track: "█",
                                    end: "🭌🬾",
                                ),
                                track_style: (
                                    fg: "#6b6055",
                                ),
                                filled_style: (
                                    fg: "#c1a387",
                                ),
                                thumb_style: (
                                    bg: "#c1a387",
                                    fg: "#6b6055",
                                ),
                            ),
                        )),
                ),
                (
                    size: "100%",
                    pane: Pane(Empty()),
                ),
                (
                    size: "40%",
                    pane: Component("states"),
                ),
                (
                    size: "1",
                    pane: Pane(Empty()),
                ),
            ],
        ),
        "states": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "100%",
                    pane: Pane(Property(
                            content: [
                                (
                                    kind: Property(Status(RepeatV2(
                                                on_label: "󰑖",
                                                off_label: "󰑗",
                                                on_style: (
                                                    fg: "#e68d53",
                                                ),
                                                off_style: (
                                                    fg: "#6b6055",
                                                ),
                                            ))),
                                ),
                                (
                                    kind: Text(" | "),
                                    style: (
                                        fg: "#6b6055",
                                    ),
                                ),
                                (
                                    kind: Property(Status(RandomV2(
                                                on_label: "",
                                                off_label: "󰒞",
                                                on_style: (
                                                    fg: "#e68d53",
                                                ),
                                                off_style: (
                                                    fg: "#6b6055",
                                                ),
                                            ))),
                                ),
                                (
                                    kind: Text(" | "),
                                    style: (
                                        fg: "#6b6055",
                                    ),
                                ),
                                (
                                    kind: Property(Status(ConsumeV2(
                                                on_label: "󰮯",
                                                off_label: "󰮯",
                                                oneshot_label: "consume-oneshot",
                                                on_style: (
                                                    fg: "#e68d53",
                                                    modifiers: "Bold",
                                                ),
                                                off_style: (
                                                    fg: "#6b6055",
                                                    modifiers: "Bold",
                                                ),
                                            ))),
                                ),
                                (
                                    kind: Text(" | "),
                                    style: (
                                        fg: "#6b6055",
                                    ),
                                ),
                                (
                                    kind: Property(Status(SingleV2(
                                                on_label: "󰬺",
                                                off_label: "󰬺",
                                                oneshot_label: "single-oneshot-on",
                                                off_oneshot_label: "single-oneshot-off",
                                                on_style: (
                                                    fg: "#e68d53",
                                                ),
                                                off_style: (
                                                    fg: "#6b6055",
                                                ),
                                            ))),
                                ),
                                (
                                    kind: Text(" "),
                                    style: (
                                        fg: "#c1a387",
                                    ),
                                ),
                            ],
                            align: Right,
                        )),
                ),
            ],
        ),
        "info": Split(
            direction: Vertical,
            panes: [
                (
                    size: "1",
                    pane: Pane(Property(
                            content: [
                                (
                                    kind: Property(Song(Title)),
                                ),
                                (
                                    kind: Text(" — "),
                                ),
                                (
                                    kind: Property(Song(Artist)),
                                    style: (
                                        fg: "#e68d53",
                                    ),
                                ),
                            ],
                            align: Center,
                        )),
                ),
                (
                    size: "1",
                    pane: Pane(Property(
                            content: [
                                (
                                    kind: Text("󰀥 "),
                                ),
                                (
                                    kind: Property(Song(Album)),
                                    style: (
                                        modifiers: Some("Bold"),
                                    ),
                                ),
                            ],
                            align: Center,
                        )),
                ),
            ],
        ),
        "time": Split(
            direction: Vertical,
            panes: [
                (
                    size: "1",
                    pane: Pane(Property(
                            content: [
                                (
                                    kind: Group([
                                            (
                                                kind: Property(Status(StateV2(
                                                            playing_label: " ",
                                                            paused_label: " ",
                                                            stopped_label: " ",
                                                        ))),
                                                style: (
                                                    fg: "yellow",
                                                    modifiers: "Bold",
                                                ),
                                            ),
                                            (
                                                kind: Property(Status(Elapsed)),
                                            ),
                                            (
                                                kind: Text("/"),
                                            ),
                                            (
                                                kind: Property(Status(Duration)),
                                            ),
                                        ]),
                                ),
                            ],
                        )),
                ),
                (
                    size: "1",
                    pane: Pane(ProgressBar),
                ),
            ],
        ),
    },
    layout: Split(
        direction: Vertical,
        panes: [
            (
                pane: Component("head"),
                size: "1",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
        ],
    ),
    header: (
        rows: [
            (
                left: [
                    (
                        kind: Property(Widget(States(
                                    active_style: (
                                        fg: "white",
                                        modifiers: "Bold",
                                    ),
                                    separator_style: (
                                        fg: "white",
                                    ),
                                ))),
                        style: (
                            fg: "dark_gray",
                        ),
                    ),
                ],
                center: [],
                right: [
                    (
                        kind: Property(Widget(ScanStatus)),
                        style: (
                            fg: "red",
                        ),
                    ),
                    (
                        kind: Property(Widget(Volume)),
                        style: (
                            fg: "blue",
                        ),
                    ),
                ],
            ),
        ],
    ),
    browser_song_format: [
        (
            kind: Group([
                    (
                        kind: Property(Track),
                    ),
                    (
                        kind: Text(" "),
                    ),
                ]),
        ),
        (
            kind: Group([
                    (
                        kind: Property(Artist),
                    ),
                    (
                        kind: Text(" - "),
                    ),
                    (
                        kind: Property(Title),
                    ),
                ]),
            default: (
                kind: Property(Filename),
            ),
        ),
    ],
    lyrics: (
        timestamp: false,
    ),
)
